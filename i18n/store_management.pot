#. module: store_management
#: model:mail.template,body_html:store_management.mail_template_store_order_confirmed
msgid ""
"<div>\n"
"    <p>Dear <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>Your order <strong t-out=\"object.name or ''\"/> has been confirmed.</p>\n"
"    <table border=\"1\" cellpadding=\"6\" style=\"border-collapse: collapse;\">\n"
"        <tr>\n"
"            <th>Product</th>\n"
"            <th>Quantity</th>\n"
"            <th>Subtotal</th>\n"
"        </tr>\n"
"        <t t-foreach=\"object.order_line\" t-as=\"line\">\n"
"            <tr t-if=\"not line.display_type\">\n"
"                <td t-out=\"line.product_id.display_name\"/>\n"
"                <td t-out=\"int(line.product_uom_qty)\"/>\n"
"                <td t-out=\"format_amount(line.price_subtotal, object.currency_id)\"/>\n"
"            </tr>\n"
"        </t>\n"
"    </table>\n"
"    <p>Total: <strong t-out=\"format_amount(object.store_total, object.currency_id)\"/></p>\n"
"    <p>The order details are attached.</p>\n"
"    <p>Thank you for shopping with us.</p>\n"
"</div>\n"
"            "
msgstr ""

