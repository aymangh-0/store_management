<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="store_restock_wizard_form" model="ir.ui.view">
        <field name="name">store.restock.wizard.form</field>
        <field name="model">store.restock.wizard</field>
        <field name="arch" type="xml">
            <form string="Restock Products">
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="current_stock" width="130px"/>
                        <field name="quantity" width="160px"/>
                    </list>
                </field>
                <group>
                    <field name="reference"
                           placeholder="e.g. Supplier invoice INV-0042"/>
                </group>
                <footer>
                    <button string="Restock" name="action_restock"
                            type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="store_restock_wizard_action" model="ir.actions.act_window">
        <field name="name">Restock</field>
        <field name="res_model">store.restock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids"
               eval="[(4, ref('store_management.group_store_manager'))]"/>
    </record>
</odoo>