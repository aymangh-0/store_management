<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="store_settings_wizard_form" model="ir.ui.view">
        <field name="name">store.settings.wizard.form</field>
        <field name="model">store.settings.wizard</field>
        <field name="arch" type="xml">
            <form string="Store Settings">
                <group>
                    <field name="daily_order_limit"/>
                </group>
                <div class="text-muted">Set 0 for no limit.</div>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="store_settings_wizard_action" model="ir.actions.act_window">
        <field name="name">Store Settings</field>
        <field name="res_model">store.settings.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>