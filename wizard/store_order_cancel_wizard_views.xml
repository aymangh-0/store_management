<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="store_order_cancel_wizard_form" model="ir.ui.view">
        <field name="name">store.order.cancel.wizard.form</field>
        <field name="model">store.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Order">
                <field name="order_id" invisible="1"/>
                    <group>
                        <field name="reason_type" widget="radio"/>
                        <field name="reason"
                               invisible="reason_type != 'other'"
                               required="reason_type == 'other'"
                               placeholder="Why is this order being cancelled?"/>
                    </group>
                <footer>
                    <button string="Cancel Order" name="action_confirm_cancel"
                            type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="store_order_cancel_wizard_action" model="ir.actions.act_window">
        <field name="name">Cancel Order</field>
        <field name="res_model">store.order.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>