<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_store_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Order <span t-field="o.name"/></h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <h5>Customer</h5>
                                <div class="fw-bold" t-field="o.partner_id.name"/>
                                <div t-field="o.partner_id"
                                     t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
                                <div t-if="o.partner_id.phone">
                                    Phone: <span t-field="o.partner_id.phone"/>
                                </div>
                                <div t-if="o.partner_id.email">
                                    Email: <span t-field="o.partner_id.email"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <h5>Order Details</h5>
                                <div>
                                    Order Date:
                                    <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                </div>
                                <div>
                                    Status: <span t-field="o.store_state"/>
                                </div>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th class="text-start">Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                    <tr>
                                        <td><span t-field="line.product_id"/></td>
                                        <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                        <td class="text-end"><span t-field="line.price_unit"/></td>
                                        <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row justify-content-end">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr class="border-black fw-bold">
                                        <td>Grand Total</td>
                                        <td class="text-end"><span t-field="o.store_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>