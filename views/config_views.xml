<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="store_sequence_action" model="ir.actions.act_window">
        <field name="name">Order Sequence</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="seq_store_order"/>
    </record>

    <record id="store_team_action" model="ir.actions.server">
        <field name="name">Store Team</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="group_ids" eval="[(4, ref('group_store_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Store Team',
    'res_model': 'res.users',
    'view_mode': 'list,form',
    'views': [(False, 'list'), (False, 'form')],
    'domain': [('all_group_ids', 'in', env.ref('store_management.group_store_user').ids)],
}
        </field>
    </record>

</odoo>