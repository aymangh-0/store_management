<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="store_order_list_view" model="ir.ui.view">
        <field name="name">sale.order.list.store</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Orders">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="store_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'sale'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="store_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_store_order', '=', True)]</field>
        <field name="context">{'default_is_store_order': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first store order
            </p>
        </field>
    </record>

    <!-- Link views to the action -->
    <record id="store_order_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="store_order_list_view"/>
        <field name="act_window_id" ref="store_order_action"/>
    </record>

</odoo>