<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="store_order_list_view" model="ir.ui.view">
        <field name="name">sale.order.list.store</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Orders">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="store_total" sum="Total"/>
                <field name="store_state" widget="badge"
                       decoration-info="store_state == 'draft'"
                       decoration-success="store_state == 'confirmed'"
                       decoration-danger="store_state == 'cancel'"/>
                <field name="store_cancel_reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="store_order_form_view" model="ir.ui.view">
        <field name="name">sale.order.form.store</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Store Order">
                <header>
                    <button name="action_store_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="%(store_management.store_order_cancel_wizard_action)d"
                            type="action"
                            string="Cancel"
                            invisible="state == 'cancel'"
                            context="{'default_order_id': id}"/>
                    <button name="action_store_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <button name="%(action_report_store_order)d" type="action"
                            string="Print"/>
                    <field name="state" invisible="1"/>
                    <field name="store_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   readonly="state != 'draft'"
                                   domain="[('is_store_customer', '=', True)]"
                                   context="{'default_is_store_customer': True}"/>
                        </group>
                        <group>
                            <field name="date_order" readonly="state != 'draft'"/>
                            <field name="store_cancel_reason" invisible="state != 'cancel'"/>
                            <field name="is_store_order" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="order_line" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="store_total"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="store_order_search_view" model="ir.ui.view">
        <field name="name">sale.order.search.store</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_line" string="Product"
                       filter_domain="[('order_line.product_id', 'ilike', self)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('store_state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('store_state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('store_state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Order Date" name="filter_date_order"
                        date="date_order"/>
                <group>
                    <filter string="Customer" name="group_customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'store_state'}"/>
                    <filter string="Order Date" name="group_date"
                            context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="store_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="store_order_search_view"/>
        <field name="domain">[('is_store_order', '=', True)]</field>
        <field name="context">{'default_is_store_order': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first store order
            </p>
        </field>
    </record>

    <!-- Link views to the action -->
    <record id="store_order_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="store_order_list_view"/>
        <field name="act_window_id" ref="store_order_action"/>
    </record>

    <record id="store_order_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="store_order_form_view"/>
        <field name="act_window_id" ref="store_order_action"/>
    </record>

</odoo>