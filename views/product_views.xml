<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Form View -->
    <record id="product_template_form_view_inherit_store" model="ir.ui.view">
        <field name="name">product.template.form.inherit.store</field>
        <field name="model">product.template</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="required">product_variant_count &lt;= 1</attribute>
            </field>
            <field name="default_code" position="after">
                <field name="store_stock_qty"/>
                <field name="store_is_low_stock"/>
                <field name="create_date" readonly="1"/>
            </field>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(store_management.store_restock_wizard_action)d"
                            type="action" string="Restock"
                            groups="store_management.group_store_manager"/>
                </header>
            </xpath>
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="string">Purchase Price</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Stock History" name="store_stock_history"
                      groups="store_management.group_store_manager">
                    <field name="store_stock_history_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="move_type"/>
                            <field name="quantity"
                                   decoration-success="quantity &gt; 0"
                                   decoration-danger="quantity &lt; 0"/>
                            <field name="stock_after"/>
                            <field name="order_id"/>
                            <field name="note"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <field name="active" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="widget">boolean_toggle</attribute>
            </field>
        </field>
    </record>

    <!-- List View -->

    <record id="product_template_list_view_inherit_store" model="ir.ui.view">
        <field name="name">product.template.list.inherit.store</field>
        <field name="model">product.template</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">default_code</attribute>
            </xpath>
            <field name="standard_price" position="attributes">
                <attribute name="string">Purchase Price</attribute>
            </field>
            <field name="standard_price" position="after">
                <field name="store_stock_qty" optional="show"
                       decoration-danger="store_is_low_stock"/>
                <field name="store_is_low_stock" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Search View -->
    <record id="product_template_search_view_inherit_store" model="ir.ui.view">
        <field name="name">product.template.search.inherit.store</field>
        <field name="model">product.template</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
            <filter string="Low Stock" name="store_low_stock"
                    domain="[('store_is_low_stock', '=', True)]"/>
                <separator/>
                <filter string="Active" name="store_active"
                        domain="[('active', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="product_template_kanban_view_store" model="ir.ui.view">
        <field name="name">product.template.kanban.store</field>
        <field name="model">product.template</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="currency_id"/>
                <field name="store_is_low_stock"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_128" widget="image"
                                   options="{'img_class': 'object-fit-contain w-100'}"
                                   alt="Product"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="default_code" class="text-muted"/>
                            <field name="list_price" widget="monetary"/>
                            <div>
                                <span>Stock: </span>
                                <field name="store_stock_qty"/>
                            </div>
                            <div t-if="record.store_is_low_stock.raw_value">
                                <span class="badge text-bg-danger">Low Stock</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Window Action -->
    <record id="store_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="product_template_search_view_inherit_store"/>
        <field name="context">{'search_default_store_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first store product
            </p>
        </field>
    </record>

    <!-- Link views to the action -->
    <record id="store_product_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_template_list_view_inherit_store"/>
        <field name="act_window_id" ref="store_product_action"/>
    </record>

    <record id="store_product_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_template_form_view_inherit_store"/>
        <field name="act_window_id" ref="store_product_action"/>
    </record>

    <record id="store_product_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="product_template_kanban_view_store"/>
        <field name="act_window_id" ref="store_product_action"/>
    </record>

</odoo>