<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view_inherit_store" model="ir.ui.view">
        <field name="name">product.template.form.inherit.store</field>
        <field name="model">product.template</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="required">product_variant_count &lt;= 1</attribute>
            </field>
            <field name="default_code" position="after">
                <field name="store_stock_qty"/>
            </field>
        </field>
    </record>

    <record id="product_template_list_view_inherit_store" model="ir.ui.view">
        <field name="name">product.template.list.inherit.store</field>
        <field name="model">product.template</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="store_stock_qty" optional="show"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_inherit_store" model="ir.ui.view">
        <field name="name">product.template.search.inherit.store</field>
        <field name="model">product.template</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter string="Low Stock (≤ 5)" name="store_low_stock"
                        domain="[('store_stock_qty', '&lt;=', 5)]"/>
                <separator/>
                <filter string="Active" name="store_active"
                        domain="[('active', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="store_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product.product_template_search_view"/>
        <field name="context">{'search_default_store_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first store product
            </p>
        </field>
    </record>
</odoo>