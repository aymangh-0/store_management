<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_store_orders" name="My Store Orders">
        <t t-call="portal.portal_layout">
            <h3 class="mt-4 mb-3">Store Orders</h3>

            <p t-if="not orders">You have no store orders yet.</p>

            <div t-if="orders" class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Date</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="orders" t-as="order">
                            <td>
                                <a t-attf-href="/my/store/orders/#{order.id}">
                                    <span t-field="order.name"/>
                                </a>
                            </td>
                            <td><span t-field="order.date_order" t-options="{'widget': 'date'}"/></td>
                            <td class="text-end"><span t-field="order.store_total"/></td>
                            <td class="text-center">
                                <span t-field="order.store_state"
                                      t-attf-class="badge rounded-pill #{
                                          'text-bg-success' if order.store_state == 'confirmed'
                                          else 'text-bg-danger' if order.store_state == 'cancel'
                                          else 'text-bg-info'}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_my_store_order" name="My Store Order">
        <t t-call="portal.portal_layout">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <h3 class="mb-0"><span t-field="order.name"/></h3>
                <span t-field="order.store_state"
                      t-attf-class="badge rounded-pill #{
                          'text-bg-success' if order.store_state == 'confirmed'
                          else 'text-bg-danger' if order.store_state == 'cancel'
                          else 'text-bg-info'}"/>
                <a class="btn btn-secondary btn-sm ms-auto"
                   t-attf-href="/my/store/orders/#{order.id}/pdf">Download PDF</a>
            </div>

            <p>
                Order Date:
                <span t-field="order.date_order" t-options="{'widget': 'date'}"/>
            </p>

            <div t-if="order.store_state == 'cancel' and order.store_cancel_reason"
                 class="alert alert-danger">
                Cancellation Reason: <span t-field="order.store_cancel_reason"/>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="order.order_line" t-as="line">
                            <tr t-if="not line.display_type">
                                <td><span t-field="line.product_id"/></td>
                                <td class="text-end"><span t-esc="int(line.product_uom_qty)"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end"><span t-field="order.store_total"/></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

    <template id="portal_breadcrumbs_store" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'store_orders'" class="breadcrumb-item active">
                Store Orders
            </li>
            <li t-if="page_name == 'store_order'" class="breadcrumb-item">
                <a href="/my/store/orders">Store Orders</a>
            </li>
            <li t-if="page_name == 'store_order'" class="breadcrumb-item active">
                <t t-out="order.name"/>
            </li>
        </xpath>
    </template>
</odoo>