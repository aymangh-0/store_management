<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_store_order_confirmed" model="mail.template">
            <field name="name">Store: Order Confirmed</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Your order {{object.name}} is confirmed</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="report_template_ids"
                   eval="[(4, ref('store_management.action_report_store_order'))]"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div>
    <p>Dear <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Your order <strong t-out="object.name or ''"/> has been confirmed.</p>
    <table border="1" cellpadding="6" style="border-collapse: collapse;">
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Subtotal</th>
        </tr>
        <t t-foreach="object.order_line" t-as="line">
            <tr t-if="not line.display_type">
                <td t-out="line.product_id.display_name"/>
                <td t-out="int(line.product_uom_qty)"/>
                <td t-out="format_amount(line.price_subtotal, object.currency_id)"/>
            </tr>
        </t>
    </table>
    <p>Total: <strong t-out="format_amount(object.store_total, object.currency_id)"/></p>
    <p>The order details are attached.</p>
    <p>Thank you for shopping with us.</p>
</div>
            </field>
        </record>
    </data>
</odoo>